{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "aevyra",
  "colors": {
    "primary": "#6E3FF3",
    "light": "#A78BFA",
    "dark": "#4C1D95"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Reflex",
        "icon": "wand-magic-sparkles",
