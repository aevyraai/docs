            "anchor": "GitHub",
            "href": "https://github.com/aevyraai/aevyra-reflex",
            "icon": "github"
          }
        ],
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "reflex/introduction",
              "reflex/quickstart"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "reflex/dashboard",
              "reflex/strategies",
              "reflex/providers",
              "reflex/configuration",
              "reflex/cli",
              "reflex/analysis",
              "reflex/explainability",
              "reflex/integrations"
            ]
          },
          {
            "group": "Tutorials",
            "pages": [
              "reflex/tutorial-security-incidents"
            ]
          },
          {
            "group": "API reference",
            "pages": [
              "reflex/api/optimizer",
              "reflex/api/result"
            ]
          },
          {
            "group": "More",
            "pages": [
              {
                "page": "GitHub",
                "href": "https://github.com/aevyraai/aevyra-reflex",
                "icon": "github"
              }
            ]
          }
        ]
      },
      {
        "tab": "Verdict",
        "icon": "gavel",
        "anchors": [
          {
            "anchor": "GitHub",
            "href": "https://github.com/aevyraai/verdict",
            "icon": "github"
          }
        ],
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "verdict/introduction",
              "verdict/quickstart"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "verdict/dataset",
              "verdict/providers",
              "verdict/metrics",
              "verdict/cli",
              "verdict/configuration"
            ]
          },
          {
            "group": "API reference",
            "pages": [
              "verdict/api/dataset",
              "verdict/api/runner",
              "verdict/api/results"
            ]
          },
          {
            "group": "More",
            "pages": [
              {
                "page": "GitHub",
                "href": "https://github.com/aevyraai/verdict",
                "icon": "github"
              }
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/aevyraai"
      }
    ]
  },
  "redirects": [
    { "source": "/docs/introduction",    "destination": "/verdict/introduction" },
    { "source": "/docs/quickstart",      "destination": "/verdict/quickstart" },
    { "source": "/docs/dataset",         "destination": "/verdict/dataset" },
    { "source": "/docs/providers",       "destination": "/verdict/providers" },
    { "source": "/docs/metrics",         "destination": "/verdict/metrics" },
    { "source": "/docs/cli",             "destination": "/verdict/cli" },
    { "source": "/docs/configuration",   "destination": "/verdict/configuration" },
    { "source": "/docs/api/dataset",     "destination": "/verdict/api/dataset" },
    { "source": "/docs/api/runner",      "destination": "/verdict/api/runner" },
    { "source": "/docs/api/results",     "destination": "/verdict/api/results" }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/aevyraai"
