{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "aevyra",
  "colors": {
    "primary": "#6E3FF3",
    "light": "#A78BFA",
    "dark": "#4C1D95"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Verdict",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "verdict/docs/introduction",
              "verdict/docs/quickstart"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "verdict/docs/dataset",
              "verdict/docs/providers",
              "verdict/docs/metrics",
              "verdict/docs/cli",
              "verdict/docs/configuration"
            ]
          },
          {
            "group": "API reference",
            "pages": [
              "verdict/docs/api/dataset",
              "verdict/docs/api/runner",
              "verdict/docs/api/results"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/aevyraai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "verdict",
      "href": "https://github.com/aevyraai/verdict"
    }
  },
  "redirects": [
    { "source": "/docs/introduction",    "destination": "/verdict/docs/introduction" },
    { "source": "/docs/quickstart",      "destination": "/verdict/docs/quickstart" },
    { "source": "/docs/dataset",         "destination": "/verdict/docs/dataset" },
    { "source": "/docs/providers",       "destination": "/verdict/docs/providers" },
    { "source": "/docs/metrics",         "destination": "/verdict/docs/metrics" },
    { "source": "/docs/cli",             "destination": "/verdict/docs/cli" },
    { "source": "/docs/configuration",   "destination": "/verdict/docs/configuration" },
    { "source": "/docs/api/dataset",     "destination": "/verdict/docs/api/dataset" },
    { "source": "/docs/api/runner",      "destination": "/verdict/docs/api/runner" },
    { "source": "/docs/api/results",     "destination": "/verdict/docs/api/results" }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/aevyraai"
    }
  }
}
